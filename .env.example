# Preview runs without environment configuration.
# Backend not connected yet:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Live Sofia requires authentication, rate limits and spend ceilings before enablement.
SOFIA_ENABLED=false
# AI_GATEWAY_API_KEY=
SOFIA_MODEL=openai/gpt-4.1-mini

# Fhilo Studio AI Build uses the same server-only gateway credential as Sofia.
# Keep this disabled until identity, abuse protections and budget caps are in place.
BUILD_AI_ENABLED=false
BUILD_AI_MODEL=openai/gpt-4.1-mini
